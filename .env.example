# Caminho do arquivo SQLite. DEVE apontar para o mountpoint fisico do pool
# (ex.: /mnt/cache/appdata/projman), NUNCA para o share FUSE (/mnt/user/...):
# o FUSE nao entrega a memoria compartilhada que o modo WAL exige.
DB_PATH=/data/projman.db

# Diretorio dos anexos. Pode ficar no share.
FILES_PATH=/files

# Hash scrypt da senha de admin. Nunca a senha em texto claro.
# Gere com: node scripts/hash-senha.ts
ADMIN_PASSWORD_HASH=

# Assina o cookie de sessao. Minimo 32 caracteres. Trocar = derrubar todas as sessoes.
# Gere com: openssl rand -base64 48
SESSION_SECRET=

# Opcional. Token do feed iCal (/ical/<token>). Vazio = feed desligado.
# Trocar = revogar o link. Gere com: openssl rand -hex 20
ICAL_TOKEN=

# Origem publica exata. Sem ela o SvelteKit rejeita todo POST com 403.
ORIGIN=https://projman.example.com
ADDRESS_HEADER=CF-Connecting-IP

PORT=3000
TZ=America/Sao_Paulo
BODY_SIZE_LIMIT=26214400
